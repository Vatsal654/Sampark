# Copy to .env.local for local development.

# Server-side only — the Next.js route handlers proxy to this URL. Never
# exposed to the browser (no NEXT_PUBLIC_ prefix).
API_BASE_URL=http://localhost:3001/v1

# Set to "true" only behind HTTPS (staging/production) so the session
# cookie is marked Secure. Local HTTP development needs this false.
COOKIE_SECURE=false
