# Copy to .env for local development. Shares most values with services/api's
# .env.example — the worker connects to the same database, Redis, and
# signs webhook callbacks with the same shared secret.

NODE_ENV=development
DATABASE_URL=postgres://sampark:sampark_dev_password@localhost:5432/sampark
REDIS_URL=redis://localhost:6379
FIELD_ENCRYPTION_ROOT_KEY=dev-only-field-encryption-key-do-not-use-prod
PROVIDER_WEBHOOK_SECRET=dev-only-webhook-secret-do-not-use-in-production-32c

# Base URL of the API's webhook intake, used by mock providers to simulate
# an asynchronous delivery-confirmation callback (docs/DATA_FLOW.md §3).
API_BASE_URL=http://localhost:3001

SMS_PROVIDER=mock
WHATSAPP_PROVIDER=mock
PUSH_PROVIDER=mock
VOICE_PROVIDER=mock
