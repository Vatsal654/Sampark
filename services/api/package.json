{
  "name": "@sampark/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "npm run build --workspace=@sampark/api-contracts",
    "build": "nest build",
    "start": "node dist/main.js",
    "prestart:dev": "npm run build --workspace=@sampark/api-contracts",
    "start:dev": "nest start --watch",
    "pretypecheck": "npm run build --workspace=@sampark/api-contracts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "pretest": "npm run build --workspace=@sampark/api-contracts",
    "test": "jest --config jest.config.js",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "test:e2e": "jest --config jest.e2e.config.js --runInBand",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
    "seed": "ts-node -r tsconfig-paths/register src/database/seeds/seed.ts",
    "dev:tag": "ts-node -r tsconfig-paths/register src/database/seeds/dev-tag-qr.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.626.0",
    "@aws-sdk/s3-request-presigner": "^3.626.0",
    "@nestjs/bullmq": "^10.2.1",
    "@nestjs/common": "^10.4.1",
    "@nestjs/core": "^10.4.1",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.1",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/typeorm": "^10.0.2",
    "@sampark/api-contracts": "^0.1.0",
    "@sampark/shared-config": "^0.1.0",
    "@sampark/shared-security": "^0.1.0",
    "bullmq": "^5.12.0",
    "dotenv": "^16.6.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.12.0",
    "qrcode-terminal": "^0.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "ulid": "^2.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.4",
    "@nestjs/testing": "^10.4.1",
    "@testcontainers/postgresql": "^10.13.0",
    "@testcontainers/redis": "^10.13.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.10",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "testcontainers": "^10.13.0",
    "ts-jest": "^29.2.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4"
  }
}
