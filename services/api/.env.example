# Copy to .env for local development. Every value below is a safe
# development default or a placeholder — never a real credential.

NODE_ENV=development
PORT=3001

# Postgres connection string. Local docker-compose exposes this on 5432.
DATABASE_URL=postgres://sampark:sampark_dev_password@localhost:5432/sampark

# Redis connection string (cache, rate limiting, OTP/session state, BullMQ).
REDIS_URL=redis://localhost:6379

# JWT signing secrets. Generate real ones with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-do-not-use-in-production-32chars
JWT_REFRESH_SECRET=dev-only-refresh-secret-do-not-use-in-production-32ch
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# HMAC secret used to sign the opaque tag ID embedded in every QR/NFC URL.
TAG_SIGNING_SECRET=dev-only-tag-signing-secret-do-not-use-in-prod-32ch

# Shared secret mock providers use to sign inbound webhook callbacks. A
# real deployment gives each provider (SMS/WhatsApp/voice/push) its own
# secret from that provider's dashboard instead of one shared value.
PROVIDER_WEBHOOK_SECRET=dev-only-webhook-secret-do-not-use-in-production-32c

# Root key for envelope encryption of Sensitive/Critical fields. In
# production this must come from a KMS, not a static env var.
FIELD_ENCRYPTION_ROOT_KEY=dev-only-field-encryption-key-do-not-use-prod

# Feature flags — every capability defaults OFF until a real provider
# contract + legal review exists. See docs/DECISIONS.md.
FEATURE_LIVE_CALL_BRIDGING=false
FEATURE_REAL_SMS=false
FEATURE_REAL_WHATSAPP=false
FEATURE_DOCUMENT_VAULT=true
FEATURE_NO_TAG_LOOKUP=false
FEATURE_REAL_PAYMENTS=false

# Object storage (MinIO locally; a real S3-compatible bucket in prod).
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=sampark-documents-dev
S3_ACCESS_KEY_ID=sampark_dev_minio
S3_SECRET_ACCESS_KEY=sampark_dev_minio_secret

# Provider selection: "mock" everywhere until a contracted provider exists.
SMS_PROVIDER=mock
WHATSAPP_PROVIDER=mock
VOICE_PROVIDER=mock
OTP_PROVIDER=mock
PUSH_PROVIDER=mock
CAPTCHA_PROVIDER=none

# Retention windows (days).
RETENTION_SCAN_SESSION_DAYS=30
RETENTION_ALERT_EVENT_DAYS=180
ACCOUNT_DELETION_GRACE_DAYS=30

# Comma-separated list of origins allowed to call this API with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002

# Swagger/OpenAPI UI at /docs — keep false in production.
SWAGGER_ENABLED=true

# Dev-mode admin SSO mock (never used when NODE_ENV=production).
ADMIN_MOCK_SSO_ENABLED=true
