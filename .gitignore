# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.next/
out/
coverage/
*.tsbuildinfo

# Env files (never commit real secrets)
.env
.env.local
.env.*.local
!.env.example
!**/.env.*.example

# Flutter / Dart
apps/mobile/.dart_tool/
apps/mobile/.flutter-plugins
apps/mobile/.flutter-plugins-dependencies
apps/mobile/.packages
apps/mobile/build/
apps/mobile/.pub-cache/
apps/mobile/ios/Pods/
apps/mobile/ios/.symlinks/
apps/mobile/android/.gradle/
apps/mobile/**/*.g.dart.bak

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS / editor
.DS_Store
.vscode/
.idea/
*.swp

# Local object storage / db volumes
infra/docker/volumes/

# Redis dump files from local/native Redis runs (e.g. manual dev-server testing)
dump.rdb

# Terraform
infra/terraform/**/.terraform/
infra/terraform/**/*.tfstate
infra/terraform/**/*.tfstate.backup
infra/terraform/**/.terraform.lock.hcl

# Test artifacts
playwright-report/
test-results/
